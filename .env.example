# =========================================================
# SUPABASE — copy this file to .env.local and fill in values
# from your Supabase project's Settings > API page.
# NEVER commit .env.local to git.
# =========================================================

# Public — safe to expose to the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. Never import this in a "use client" file
# or any file under src/app/(public). Used only in Server Actions /
# Route Handlers / Server Components that need to bypass RLS
# (e.g. admin user management, seeding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =========================================================
# APP CONFIG
# =========================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Travinco

# =========================================================
# EMAIL (optional — for admin notification on new enquiry/contact,
# and for the enquiry/contact form's email verification links)
# Using Resend as the reference provider for admin notifications;
# leave blank to disable. Gmail SMTP is used for the verification
# links specifically — see src/lib/email/gmail.ts.
# =========================================================
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=admin@example.com
NOTIFICATION_EMAIL_FROM=notifications@example.com

# Gmail SMTP — used to send the "verify your email" links on the
# enquiry/contact forms. GMAIL_APP_PASSWORD is a 16-character App
# Password from myaccount.google.com/apppasswords, NOT your normal
# Gmail login password. Requires 2-Step Verification to be turned on
# for that Google account first.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# =========================================================
# WHATSAPP BUSINESS API (official provider only)
# Leave blank to run in mock mode — campaigns will be created
# and logged but no real messages sent. See src/lib/whatsapp/.
# =========================================================
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# =========================================================
# SEED DATA
# Set to "true" only in local/dev to allow the seed script to run.
# The seed script refuses to run if this is not explicitly true.
# =========================================================
ALLOW_DEMO_SEED=true
